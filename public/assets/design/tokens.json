{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Cyberpunk 2077-inspired industrial editorial portfolio; acid yellow, dark hardware surfaces, restrained cyan signals and deliberate motion.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.988,
          0.933,
          0.039
        ],
        "hex": "#fcee0a"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.271,
          0.898,
          0.871
        ],
        "hex": "#45e5de"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.42,
          0.616
        ],
        "hex": "#ff6b9d"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.031,
          0.043,
          0.063
        ],
        "hex": "#080b10"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.094,
          0.125
        ],
        "hex": "#111820"
      }
    },
    "raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.145,
          0.188
        ],
        "hex": "#1a2530"
      }
    },
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.953,
          0.945,
          0.91
        ],
        "hex": "#f3f1e8"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.667,
          0.71,
          0.749
        ],
        "hex": "#aab5bf"
      }
    },
    "line": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.443,
          0.529,
          0.592
        ],
        "hex": "#718797"
      }
    },
    "danger": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          0.467,
          0.467
        ],
        "hex": "#ff7777"
      }
    },
    "success": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.502,
          0.902,
          0.69
        ],
        "hex": "#80e6b0"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "2xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "3xl": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    },
    "4xl": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    },
    "5xl": {
      "$value": {
        "value": 128,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    }
  },
  "typography": {
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 6,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.04,
          "unit": "em"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 3,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Chakra Petch",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 400
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0.1,
          "unit": "em"
        }
      }
    }
  }
}
